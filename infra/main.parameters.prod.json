{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "australiaeast"
    },
    "staticWebAppLocation": {
      "value": "eastasia"
    },
    "workloadName": {
      "value": "earlylearner"
    },
    "environmentName": {
      "value": "prod"
    },
    "postgresAdminLogin": {
      "value": "earlylearneradmin"
    },
    "postgresAllowAzureServices": {
      "value": true
